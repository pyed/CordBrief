# CordBrief Minimal Runtime Collector Dockerfile
# Lightweight headless daemon running official Discord + Vencord dist under Xvfb
# Completely stripped of Xpra, Python, Git, Pnpm, Compilers, and Vencord source tree

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# 1. Base packages & minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    procps \
    xvfb \
    dbus \
    dbus-x11 \
    gnome-keyring \
    libsecret-1-0 \
    libsecret-tools \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libxshmfence1 \
    libxss1 \
    libxtst6 \
    xdg-utils \
    openbox \
    nodejs \
    && rm -rf /var/lib/apt/lists/*

# 2. Create unprivileged runtime user 'cordbrief'
RUN useradd -u 1000 -m -s /bin/bash cordbrief \
    && mkdir -p /home/cordbrief/.config/discord \
    && mkdir -p /home/cordbrief/.local/share/keyrings \
    && mkdir -p /var/cordbrief/exchange \
    && mkdir -p /var/lib/cordbrief \
    && mkdir -p /var/cordbrief/runtime \
    && chown -R cordbrief:cordbrief /home/cordbrief /var/cordbrief /var/lib/cordbrief \
    && chmod 0700 /var/lib/cordbrief

# 3. Copy runtime scripts
COPY entrypoint-runtime.sh /usr/local/bin/entrypoint-runtime.sh
COPY runtime.mjs /home/cordbrief/runtime.mjs
COPY stage-runtime.mjs /home/cordbrief/stage-runtime.mjs
COPY supervisor.mjs /home/cordbrief/supervisor.mjs

RUN chmod +x /usr/local/bin/entrypoint-runtime.sh \
             /home/cordbrief/runtime.mjs \
             /home/cordbrief/stage-runtime.mjs \
             /home/cordbrief/supervisor.mjs \
    && chown cordbrief:cordbrief /home/cordbrief/*.mjs

USER cordbrief
WORKDIR /home/cordbrief

VOLUME ["/home/cordbrief/.config/discord", "/home/cordbrief/.local/share/keyrings", "/var/cordbrief/exchange", "/var/lib/cordbrief", "/var/cordbrief/runtime"]

ENTRYPOINT ["/usr/local/bin/entrypoint-runtime.sh"]
