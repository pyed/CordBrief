# Optional: Settings can store these instead. Nonempty environment values win.
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=

# Discord Developer Application credentials for official Discord local RPC.
# DISCORD_CLIENT_ID can be set here.
# DISCORD_CLIENT_SECRET can be set here or securely seeded into volume storage
# via scripts/update_secret.sh (Linux/macOS) or scripts/update_secret.ps1 (Windows).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
