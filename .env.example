# Optional: Settings can store these instead. Nonempty environment values win.
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=

# Discord Developer Application credentials for official Discord local RPC.
# DISCORD_CLIENT_ID is public application configuration and is set here.
# DISCORD_CLIENT_SECRET MUST NOT be stored in this file. Seed it directly into
# private container storage (mode 0600) via scripts/update_secret.sh or scripts/update_secret.ps1.
DISCORD_CLIENT_ID=
